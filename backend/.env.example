# -----------------------------------------------------------------------------
# NutriTrack Backend Configuration Template
# NOTE: Never commit real credentials to version control.
# Copy this file to .env and adjust values for your local environment.
# -----------------------------------------------------------------------------

# Application Settings
ENVIRONMENT=development
DEBUG=true
PROJECT_NAME="NutriTrack API"
API_V1_STR="/api/v1"

# Server Host & Port
HOST=127.0.0.1
PORT=8000

# MongoDB Configuration
# For local development: mongodb://127.0.0.1:27017
# For MongoDB Atlas: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB_NAME=nutritrack

# Security / JWT Settings
# Generate a secure 32+ character random string in production (e.g. openssl rand -hex 32)
SECRET_KEY=change_this_to_a_secure_random_key_in_production
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# CORS Allowed Origins (comma-separated list or JSON array)
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
